<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- ===== HEADER (HTML'deki sticky header) ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/brandLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/logoIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_logo"
                android:elevation="3dp"
                android:fontFamily="@font/fa_solid"
                android:gravity="center"
                android:text="@string/fa_utensils"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/brandTitle"
                    style="@style/Text.Serif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textSize="24sp"
                    tools:text="PantryChef" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:letterSpacing="0.05"
                    android:text="@string/brand_tagline"
                    android:textAllCaps="true"
                    android:textColor="@color/sage"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_nav_pill"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/navMatcher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_active"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="Pantry Matcher" />

            <TextView
                android:id="@+id/navExplorer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_inactive"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/charcoal"
                android:textSize="14sp"
                tools:text="Recipe Explorer" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== TAB 1: PANTRY MATCHER ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tabMatcher"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="32dp"
                android:paddingEnd="16dp"
                android:paddingBottom="32dp">

                <!-- Hero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_badge_soft"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:letterSpacing="0.05"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="@string/hero_badge"
                        android:textAllCaps="true"
                        android:textColor="@color/terracotta"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/Text.Serif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:lineSpacingMultiplier="1.1"
                        android:text="@string/hero_title"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/hero_body"
                        android:textColor="@color/charcoal_70"
                        android:textSize="16sp" />

                    <!-- Özel malzeme ekleme -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/customIngredientInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints=""
                            android:background="@drawable/bg_input"
                            android:hint="@string/custom_ingredient_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:paddingStart="44dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:textColor="@color/charcoal"
                            android:textColorHint="@color/charcoal_40"
                            android:textCursorDrawable="@null"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="16dp"
                            android:fontFamily="@font/fa_solid"
                            android:text="@string/fa_plus"
                            android:textColor="@color/charcoal_40"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/addToPantryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:elevation="3dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:paddingStart="24dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="12dp"
                        android:text="@string/add_to_pantry"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Eyebrow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/popular_staples" />

                        <TextView
                            android:id="@+id/resetPantryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:padding="4dp"
                            android:textColor="@color/terracotta"
                            android:textSize="12sp"
                            tools:text="Reset Pantry" />
                    </LinearLayout>

                    <com.student.recipes.ui.MaxHeightScrollView
                        android:id="@+id/pantryChipsScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbarSize="6dp"
                        android:scrollbarThumbVertical="@drawable/bg_chip_selected"
                        android:scrollbars="vertical"
                        app:pcMaxHeight="192dp">

                        <com.student.recipes.ui.FlowLayout
                            android:id="@+id/pantryChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingEnd="8dp"
                            app:pcHorizontalSpacing="8dp"
                            app:pcVerticalSpacing="8dp" />
                    </com.student.recipes.ui.MaxHeightScrollView>
                </LinearLayout>

                <!-- Sonuç başlığı -->
                <TextView
                    style="@style/Text.Serif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/suggested_matches"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/matcherCountText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/matcher_count_initial"
                    android:textColor="@color/charcoal_60"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/show_label" />

                    <Spinner
                        android:id="@+id/matchFilterSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner"
                        android:dropDownVerticalOffset="4dp"
                        android:popupBackground="@drawable/bg_card_outline"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/sand" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/matcherGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <include
                    android:id="@+id/matcherEmpty"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== TAB 2: RECIPE EXPLORER ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tabExplorer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="32dp"
                android:paddingEnd="16dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_explorer_box"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/explorerSearch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints=""
                            android:background="@drawable/bg_input"
                            android:hint="@string/explorer_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="44dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp"
                            android:textColor="@color/charcoal"
                            android:textColorHint="@color/charcoal_40"
                            android:textCursorDrawable="@null"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="16dp"
                            android:fontFamily="@font/fa_solid"
                            android:text="@string/fa_magnifying_glass"
                            android:textColor="@color/charcoal_40"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/categoryButtons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="8dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:id="@+id/explorerCountText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/explorer_count_initial"
                    android:textColor="@color/charcoal_60"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/explorerGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <include
                    android:id="@+id/explorerEmpty"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
